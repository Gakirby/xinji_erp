### =====================================================================
###  吉林鑫基矿业 · 矿石配送 ERP  —— 接口验收请求集
###  用法：用 IntelliJ IDEA 打开本文件，每个请求左边会出现绿色箭头，点一下即可运行。
###        运行时会自动把 token、单号等变量存到全局，后面的请求直接复用，从上往下点完就是一次完整验收。
###  注意：先启动应用（ErpApplication 或 java -jar），再执行本文件。
### =====================================================================

@host = http://127.0.0.1:8080

### ---------------------------------------------------------------------
### 01 员工登录（ERP 运营后台）
### 期望：code=0，返回 token、role=ADMIN、displayName=李国强
### ---------------------------------------------------------------------
# @name employeeLogin
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "admin123",
  "userType": "EMPLOYEE"
}

> {%
    client.test("员工登录成功", function () {
        client.assert(response.body.code === 0, "登录失败: " + response.body.msg);
        client.assert(response.body.data.role === "ADMIN", "角色不对");
    });
    client.global.set("adminToken", response.body.data.token);
%}

### ---------------------------------------------------------------------
### 02 客户登录（网页商城 / 小程序共用同一个 customer_id）
### 期望：code=0，customerId=1，displayName=长春亚泰建材有限公司
### ---------------------------------------------------------------------
# @name customerLogin
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "yatai",
  "password": "123456",
  "userType": "CUSTOMER"
}

> {%
    client.test("客户登录成功", function () {
        client.assert(response.body.code === 0, "登录失败: " + response.body.msg);
        client.assert(response.body.data.customerId === 1, "customer_id 不对");
    });
    client.global.set("customerToken", response.body.data.token);
%}

### ---------------------------------------------------------------------
### 03 当前登录信息
### ---------------------------------------------------------------------
GET {{host}}/api/auth/me
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------
### 04 【三端隔离】客户 token 访问后台接口
### 期望：{"code":403,"msg":"无权限访问管理后台接口"}
### 这一条是客户最关心的：运营后台不能被客户看到，靠后端拦，不是靠前端藏菜单
### ---------------------------------------------------------------------
GET {{host}}/api/admin/orders?page=1&size=5
Authorization: Bearer {{customerToken}}

> {%
    client.test("客户访问后台被拦截", function () {
        client.assert(response.body.code === 403, "没拦住！实际: " + JSON.stringify(response.body));
    });
%}

### ---------------------------------------------------------------------
### 05 【三端隔离】不带 token 访问后台接口
### 期望：{"code":401,"msg":"缺少登录凭证，请先登录"}
### ---------------------------------------------------------------------
GET {{host}}/api/admin/orders?page=1&size=5

### ---------------------------------------------------------------------
### 06 客户端商品列表（库存双池）
### 期望：石灰石 5-10mm —— 可售 2344 / 活动 800 / 冻结 96 / 总量 3240
###       三个池子加起来 = 物理总库存，这是验收重点
### ---------------------------------------------------------------------
GET {{host}}/api/client/products
Authorization: Bearer {{customerToken}}

> {%
    client.test("双池恒等式成立", function () {
        const s = response.body.data[0];
        client.assert(s.saleableQty + s.activityAllocQty + s.frozenQty === s.totalQty,
            "三个池子加起来不等于总库存");
    });
%}

### ---------------------------------------------------------------------
### 07 商品详情
### ---------------------------------------------------------------------
GET {{host}}/api/client/products/1
Authorization: Bearer {{customerToken}}

### ---------------------------------------------------------------------
### 08 后台物料列表（三个库存口径，实时读库不走缓存）
### ---------------------------------------------------------------------
GET {{host}}/api/admin/products
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------
### 09 库存预警（只返回低于安全库存的物料）
### ---------------------------------------------------------------------
GET {{host}}/api/admin/products/warnings
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------
### 10 采购建单
### ---------------------------------------------------------------------
# @name createPurchase
POST {{host}}/api/admin/purchase/orders
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "supplierName": "龙潭采石场",
  "skuId": 2,
  "planQty": 200,
  "price": 58.00,
  "expectedDate": "2026-11-08"
}

> {%
    client.global.set("purchaseId", response.body.data.id);
%}

### ---------------------------------------------------------------------
### 11 采购到货入库 120 吨
### 期望：状态 PARTIAL，到货金额 6960（120×58）
### ---------------------------------------------------------------------
POST {{host}}/api/admin/purchase/orders/{{purchaseId}}/arrive
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "arrivedQty": 120,
  "remark": "第一车到货"
}

### ---------------------------------------------------------------------
### 12 采购到货后查台账
### 期望：一条 INBOUND 120 吨，beforeQty 1160 → afterQty 1280
### ---------------------------------------------------------------------
GET {{host}}/api/admin/stock/flows?skuId=2&page=1&size=3
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------
### 13 【核心链路】客户下单 30 吨石灰石
### 期望：返回订单号；可售 2344→2314，冻结 96→126，总库存仍是 3240
### ---------------------------------------------------------------------
# @name createOrder
POST {{host}}/api/client/orders
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "deliveryType": "DELIVERY",
  "expectedDate": "11-05 08:00 — 12:00",
  "receiver": "张伟",
  "address": "吉林省长春市二道区英俊镇建龙北路18号",
  "items": [
    { "skuId": 1, "qty": 30 }
  ],
  "remark": "验收测试单"
}

> {%
    client.test("下单成功", function () {
        client.assert(response.body.code === 0, "下单失败: " + response.body.msg);
    });
    client.global.set("orderNo", response.body.data.order.orderNo);
%}

### ---------------------------------------------------------------------
### 14 下单后校验：可售减少、冻结增加、总量不变
### ---------------------------------------------------------------------
GET {{host}}/api/client/products
Authorization: Bearer {{customerToken}}

### ---------------------------------------------------------------------
### 15 【防超卖】下单 99999 吨
### 期望：{"code":500,"msg":"「石灰石 5-10mm」可售库存不足，当前可售 2314 吨，本次需要 99999 吨"}
### ---------------------------------------------------------------------
POST {{host}}/api/client/orders
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "deliveryType": "DELIVERY",
  "expectedDate": "11-05",
  "receiver": "张伟",
  "address": "长春",
  "items": [
    { "skuId": 1, "qty": 99999 }
  ]
}

> {%
    client.test("超量下单被拦截", function () {
        client.assert(response.body.code === 500, "没拦住！");
    });
%}

### ---------------------------------------------------------------------
### 16 后台审核通过 → AUDITED
### ---------------------------------------------------------------------
POST {{host}}/api/admin/orders/{{orderNo}}/audit
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------
### 17 派车 → DISPATCHED
### ---------------------------------------------------------------------
POST {{host}}/api/admin/orders/{{orderNo}}/dispatch
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------
### 18 出厂 → SHIPPED（核销冻结量，physical 库存减少 30）
### ---------------------------------------------------------------------
POST {{host}}/api/admin/orders/{{orderNo}}/ship
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------
### 19 出厂后校验：冻结 126→96，总库存 3240→3210
### ---------------------------------------------------------------------
GET {{host}}/api/client/products
Authorization: Bearer {{customerToken}}

### ---------------------------------------------------------------------
### 20 过磅出票
### 期望：净重 35.200、扣水 0.387、扣杂 0.150、结算 34.663
### ---------------------------------------------------------------------
POST {{host}}/api/admin/weigh/tickets
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "orderNo": "{{orderNo}}",
  "skuId": 1,
  "plateNo": "吉B·9T001",
  "driverName": "赵师傅",
  "driverPhone": "13900008811",
  "grossWeight": 52.400,
  "tareWeight": 17.200,
  "waterRate": 0.011,
  "impurityDeductWeight": 0.150,
  "weighman": "王立"
}

> {%
    client.test("过磅计算正确", function () {
        const d = response.body.data;
        client.assert(Math.abs(d.netWeight - 35.2) < 0.001, "净重不对: " + d.netWeight);
        client.assert(Math.abs(d.settleWeight - 34.663) < 0.001, "结算量不对: " + d.settleWeight);
    });
%}

### ---------------------------------------------------------------------
### 21 过磅后查订单明细：settleQty 应已回填 34.663，settleAmount 2981.02
### ---------------------------------------------------------------------
GET {{host}}/api/admin/orders/{{orderNo}}
Authorization: Bearer {{adminToken}}

> {%
    client.test("结算量已回填", function () {
        const it = response.body.data.items[0];
        client.assert(Math.abs(it.settleQty - 34.663) < 0.001, "结算量没回填");
    });
%}

### ---------------------------------------------------------------------
### 22 客户签收 → SIGNED
### ---------------------------------------------------------------------
POST {{host}}/api/admin/orders/{{orderNo}}/sign
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------
### 23 磅单列表
### ---------------------------------------------------------------------
GET {{host}}/api/admin/weigh/tickets
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------
### 24 生成对账批次（客户 2 吉林建龙，账期 2026-11-01）
### 说明：种子数据里 XJ20261101008 是 SIGNED 状态，会被收进批次并自动转 SETTLED
### ---------------------------------------------------------------------
# @name createSettlement
POST {{host}}/api/admin/finance/settlements
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "customerId": 2,
  "periodStart": "2026-11-01",
  "periodEnd": "2026-11-01"
}

> {%
    client.global.set("settlementId", response.body.data.id);
%}

### ---------------------------------------------------------------------
### 25 对账明细
### ---------------------------------------------------------------------
GET {{host}}/api/admin/finance/settlements/{{settlementId}}/items
Authorization: Bearer {{adminToken}}

### ---------------------------------------------------------------------
### 26 客户确认对账 → 生成应收（30 天账期）
### ---------------------------------------------------------------------
# @name confirmSettlement
POST {{host}}/api/admin/finance/settlements/{{settlementId}}/confirm
Authorization: Bearer {{adminToken}}

> {%
    client.global.set("receivableId", response.body.data.id);
%}

### ---------------------------------------------------------------------
### 27 重复确认被拦截
### 期望：{"code":500,"msg":"该批次状态为「CONFIRMED」，不能重复确认"}
### ---------------------------------------------------------------------
POST {{host}}/api/admin/finance/settlements/{{settlementId}}/confirm
Authorization: Bearer {{adminToken}}

