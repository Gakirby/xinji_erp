# @name createInvoice
POST {{host}}/api/admin/finance/invoices
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "receivableId": 3,
  "invoiceType": "VAT_SPECIAL",
  "taxRate": 0.13,
  "remark": "IDEA 验收开票"
}

> {%
    client.test("开票申请成功", function () {
        client.assert(response.body.code === 0, "开票失败: " + response.body.msg);
    });
    client.global.set("invoiceId", response.body.data.id);
%}

###
POST {{host}}/api/admin/finance/invoices/{{invoiceId}}/issue
Authorization: Bearer {{adminToken}}

