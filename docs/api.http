Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "seckillSkuId": 3,
  "qty": 100
}

### ---------------------------------------------------------------------
### 37 查令牌发放结果（Redis Stream 异步落库）
### 说明：抢购是异步发券，等 1~2 秒再点这条，状态应为 ISSUED
### ---------------------------------------------------------------------
GET {{host}}/api/client/seckill/tokens/{{tokenNo}}
Authorization: Bearer {{customerToken}}

> {%
    client.test("令牌已发放", function () {
        client.assert(response.body.data.status === "ISSUED", "当前状态: " + response.body.data.status);
    });
%}

### ---------------------------------------------------------------------
### 38 我的抢购记录
### ---------------------------------------------------------------------
GET {{host}}/api/client/seckill/tokens
Authorization: Bearer {{customerToken}}

### ---------------------------------------------------------------------
### 39 令牌核销下单（活动价 72 元/吨 × 20 吨 = 1440 元）
### ---------------------------------------------------------------------
POST {{host}}/api/client/seckill/tokens/{{tokenNo}}/order
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "deliveryType": "DELIVERY",
  "expectedDate": "11-05 08:00 — 12:00",
  "receiver": "张伟",
  "address": "吉林省长春市二道区英俊镇建龙北路18号"
}

> {%
    client.test("活动价成交", function () {
        const o = response.body.data.order;
        client.assert(o.orderType === "SECKILL", "订单类型不对");
        client.assert(o.payAmount === 1440, "金额不对: " + o.payAmount);
    });
%}

### ---------------------------------------------------------------------
### 40 【双池关键校验】兑换后活动划拨量 800→780，销售可售量不变
### 这一条最能说明「活动库存独立于销售库存」
### ---------------------------------------------------------------------
GET {{host}}/api/client/products
Authorization: Bearer {{customerToken}}

> {%
    client.test("活动池扣减、销售池不动", function () {
        const s = response.body.data[0];
        client.assert(s.activityAllocQty === 780, "活动池没扣: " + s.activityAllocQty);
        client.assert(s.saleableQty === 2314, "销售池不该变: " + s.saleableQty);
    });
%}

